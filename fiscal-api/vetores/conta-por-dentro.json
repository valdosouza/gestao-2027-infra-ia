{
  "funcao": "contaPorDentro",
  "versao": 1,
  "regras": [
    "RF-PRC-02",
    "RF-PRC-03",
    "RF-PRC-04",
    "RF-BC-04"
  ],
  "convencao": {
    "numeros": "valores e alíquotas são STRINGS decimais (nunca número JSON), para não perder precisão; reais com 2 casas",
    "aliquotas": "fração decimal: \"0.12\" = 12%",
    "datas": "AAAA-MM-DD; instantes em UTC: AAAA-MM-DDTHH:MM:SSZ",
    "grau": "T = escrito na norma · L = leitura nossa · E = observado em homologação ou produção"
  },
  "descricao": "Item de NF-e ou NFC-e do regime normal com o preço final como entrada (IBS e CBS dentro do preço, ICMS por dentro). Entrada: valor cobrado do item P (sem IPI), alíquota do ICMS e alíquotas efetivas de IBS e CBS. Saída: ICMS, base do IBS/CBS, IBS, CBS e vProd líquido, fechando vProd + vIBS + vCBS = P com a tolerância de 0,01 da NT (UB35-10).",
  "propriedades": [
    "vProd + vIBS + vCBS == P em todos os casos (fecha = true)",
    "vIBS e vCBS ficam a no máximo 0,01 de vBC x alíquota (tolerância da NT)",
    "icms == P x aliquotaICMS arredondado a 2 casas (meio para cima)"
  ],
