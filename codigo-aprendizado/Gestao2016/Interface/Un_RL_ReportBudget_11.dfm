  inherited Qr_ItensPro: TSTQuery
    SQL.Strings = (
      'SELECT '
      '  ICT_CODIGO CODIGO,  '
      '  ICT_CODCTC MASTER,'
      '  PRO_CODIGOFAB,'
      '  PRO_DESCRICAO,'
      '  ICT_TIPO TIPO,'
      '  ICT_CODVCL DETALHE,'
      '  ICT_QTDE QTDE,'
      '  ICT_VL_UNIT VL_UNIT,'
      '  ICT_VL_DESC VL_DESC,'
      '  (ICT_QTDE * ICT_VL_UNIT) AS SUBTOTAL'
      'FROM TB_ITENS_CTC'
      '   LEFT OUTER JOIN TB_PRODUTO'
      '   ON (PRO_CODIGO = ICT_CODVCL)'
      'WHERE (ICT_CODPED =:PED_CODIGO) AND (PRO_TIPO = '#39'P'#39')'
      'ORDER BY PRO_DESCRICAO')
  end
end
