  inherited Qr_Pedido: TSTQuery
    SQL.Strings = (
      'SELECT '
      'EMP_NOME,'
      'EMP_CODIGO,'
      'END_ENDER,'
      'END_NUMERO,'
      'END_COMPLEM,'
      'END_CONTATO,'
      'END_CEP,'
      'END_FONE,'
      'END_BAIRRO,'
      'CDD_DESCRICAO,'
      'END_FAX,'
      'EMP_CNPJ,'
      'EMP_INSC_EST,'
      'END_CELULAR,'
      'FPT_DESCRICAO,'
      'CTC_PRAZO,'
      'CTC_OBS,'
      'CLB_NOME,'
      'CTC_NUMERO,'
      'CTC_DATA,'
      'UFE_SIGLA ,'
      'CTC_VL_DESCONTO'
      ''
      'FROM TB_COTACAO ctc'
      '   INNER JOIN TB_EMPRESA emp'
      '  ON (emp.EMP_CODIGO = ctc.CTC_CODEMP)'
      ''
      '  INNER JOIN TB_ENDERECO tb_endereco'
      '  ON (tb_endereco.END_CODEMP = emp.EMP_CODIGO)'
      ''
      '  INNER JOIN tb_cidade tb_cidade'
      '  ON (tb_cidade.cdd_codigo = tb_endereco.end_codcdd)'
      ''
      '  INNER JOIN tb_uf tb_uf'
      '  ON (tb_uf.ufe_codigo = tb_endereco.end_codufe)'
      ''
      '  INNER JOIN TB_FORMAPAGTO tb_formapagto'
      '  ON (tb_formapagto.FPT_CODIGO = ctc.CTC_CODFPG)'
      ''
      '  INNER JOIN TB_COLABORADOR tb_colaborador'
      '  ON (tb_colaborador.CLB_CODIGO = ctc.CTC_CODVDO)'
      ''
      'WHERE(CTC_CODPED =:PED_CODIGO)')
    Left = 120
    Top = 144
  end
  inherited Qr_ItensPro: TSTQuery
    SQL.Strings = (
      'SELECT '
      '  ICT_CODIGO,'
      '  ICT_CODPED,'
      '  ICT_CODVCL,'
      '  PRO_CODIGOFAB,'
      '  PRO_DESCRICAO,'
      '  ICT_QTDE QTDE,'
      '  ICT_VL_CUSTO,'
      '  ICT_VL_UNIT VL_UNIT,'
      '  ICT_AQ_COM,'
      '  MED_ABREVIATURA,'
      '  PRO_CODIGOFOR,'
      '  (ICT_QTDE * ICT_VL_UNIT) SUBTOTAL'
      'FROM TB_ITENS_CTC'
      '   INNER JOIN TB_PRODUTO'
      '   ON (PRO_CODIGO = ICT_CODVCL)'
      '   INNER JOIN TB_MEDIDA tb_medida'
      '   ON  (tb_medida.MED_CODIGO = tb_produto.PRO_CODMED)'
      'WHERE (ICT_CODPED=:PED_CODIGO) AND (PRO_TIPO = '#39'P'#39')'
      'ORDER BY PRO_DESCRICAO')
    Left = 185
    Top = 144
  end
