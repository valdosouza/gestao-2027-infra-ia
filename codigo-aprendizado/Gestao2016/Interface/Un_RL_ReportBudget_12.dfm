  inherited Qr_Pedido: TSTQuery
    Active = False
    SQL.Strings = (
      'SELECT '
      ' CTC_FANTASIA,'
      'EMP_NOME ,'
      'ctc_codemp,'
      'END_ENDER,'
      'END_NUMERO,'
      'END_COMPLEM,'
      'END_CONTATO,'
      'END_CEP,'
      'END_FONE,'
      'END_BAIRRO,'
      'CDD_DESCRICAO,'
      'END_FAX,'
      'EMP_CNPJ,'
      'EMP_INSC_EST,'
      'END_CELULAR,'
      'FPT_DESCRICAO,'
      'CTC_PRAZO PRAZO,'
      'CTC_OBS OBS,'
      'CLB_NOME,'
      'CTC_NUMERO,'
      'CTC_DATA,'
      'UFE_SIGLA ,'
      'CTC_VL_DESCONTO,'
      ' CTC_CONTATO'
      ''
      'FROM TB_COTACAO ctc'
      '   LEFT OUTER JOIN TB_EMPRESA emp'
      '  ON (emp.EMP_CODIGO = ctc.CTC_CODEMP)'
      ''
      '  LEFT OUTER JOIN TB_ENDERECO tb_endereco'
      '  ON (tb_endereco.END_CODEMP = emp.EMP_CODIGO)'
      ''
      '  LEFT OUTER JOIN tb_cidade tb_cidade'
      '  ON (tb_cidade.cdd_codigo = tb_endereco.end_codcdd)'
      ''
      '  LEFT OUTER JOIN tb_uf tb_uf'
      '  ON (tb_uf.ufe_codigo = tb_endereco.end_codufe)'
      ''
      '  INNER JOIN TB_FORMAPAGTO tb_formapagto'
      '  ON (tb_formapagto.FPT_CODIGO = ctc.CTC_CODFPG)'
      ''
      '  INNER JOIN TB_COLABORADOR tb_colaborador'
      '  ON (tb_colaborador.CLB_CODIGO = ctc.CTC_CODVDO)'
      ''
      'WHERE(CTC_CODPED =:PED_CODIGO)')
  end
  inherited Qr_ItensPro: TSTQuery
    SQL.Strings = (
      'SELECT '
      '  ICT_CODIGO CODIGO,  '
      '  ICT_CODCTC MASTER,'
      '  PRO_CODIGOFAB,'
      '  ICT_DESCRICAO DESC_PRODUTO,'
      '  ICT_TIPO TIPO,'
      '  ICT_CODVCL DETALHE,'
      '  ICT_QTDE QTDE,'
      '  ICT_VL_UNIT VL_UNIT,'
      '  ICT_VL_DESC VL_DESC,'
      '  (ICT_QTDE * ICT_VL_UNIT) AS SUBTOTAL'
      'FROM TB_ITENS_CTC'
      '   LEFT OUTER JOIN TB_PRODUTO'
      '   ON (PRO_CODIGO = ICT_CODVCL)'
      'WHERE (ICT_CODPED =:PED_CODIGO) '
      'ORDER BY PRO_DESCRICAO')
  end
end
