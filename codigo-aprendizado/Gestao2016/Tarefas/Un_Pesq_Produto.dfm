  object Qr_Movimento: TSTQuery
    Connection = DM.IBD_Gestao
    Transaction = DM.IBT_Consulta
    UpdateTransaction = DM.IBT_Consulta
    SQL.Strings = (
      
        'select distinct tb_ctrl_estoque.cet_codpro, tb_ctrl_estoque.cet_' +
        'codets, tb_ctrl_estoque.cet_data'
      'from tb_ctrl_estoque'
      'where tb_ctrl_estoque.cet_data >= ('
      'select max(tb_ctrl_estoque.cet_data)'
      'from tb_ctrl_estoque)')
    ForcedRefresh = True
    Database = DM.IBD_Gestao
