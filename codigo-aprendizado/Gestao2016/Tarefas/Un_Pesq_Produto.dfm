      ' ,tb_promocao.PRC_QT_MIN PRC_QTDE '
      ' ,CAST(SUM(EST_QTDE) AS NUMERIC(18, 6)) EST_QTDE '
      'FROM TB_PRODUTO tb_produto '
      '  INNER JOIN tb_preco tb_normal '
      
        '  ON ((tb_normal.prc_codpro = tb_produto.pro_codigo) and (tb_nor' +
