  object Qr_Preco_Qtde: TSTQuery
    Connection = DM.IBD_Gestao
    Transaction = DM.IBT_Estoque
    UpdateTransaction = DM.IBT_Estoque
    SQL.Strings = (
      'SELECT'
      '  PRC_CODIGO,'
      'PRC_VL_VDA,'
      'PRC_QT_MIN,'
      'PRO_CAMPANHA'
      'FROM TB_PRECO'
      
        'INNER JOIN TB_PRODUTO TB_PRODUTO ON TB_PRODUTO.PRO_CODIGO = TB_P' +
        'RECO.PRC_CODPRO'
      'WHERE (PRC_CODPRO =:PRC_CODPRO) AND'
      '               (PRC_CODTPR =:PRC_CODTPR)')
