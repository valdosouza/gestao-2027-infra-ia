      'FROM TB_FOLHAPAGTO Tb_flhpagto'
      '   INNER JOIN TB_COLABORADOR tb_colaborador'
      '   ON (tb_colaborador.CLB_CODIGO = Tb_flhpagto.FPT_CODCLB)')
