  object Qr_ProxCodigo: TSTQuery
    Connection = DM.IBD_Gestao
    Transaction = DM.IB_Transacao
    UpdateTransaction = DM.IB_Transacao
    SQL.Strings = (
      'SELECT PLC_CODPLANO FROM TB_PLANOCONTAS'
      '  Where PLC_CODPLANO>=:CODIGOINI and '
      '              PLC_CODPLANO<=:CODIGOFIM')
    ForcedRefresh = False
    Database = DM.IBD_Gestao
    BufferChunks = 1000
    ParamCheck = True
    Left = 344
    Top = 120
    ParamData = <
      item
        Name = 'CODIGOINI'
      end
      item
        Name = 'CODIGOFIM'
      end>
  end
  object Qr_ProxNivel: TSTQuery
    Connection = DM.IBD_Gestao
    Transaction = DM.IB_Transacao
    UpdateTransaction = DM.IB_Transacao
    SQL.Strings = (
      'SELECT MAX(PLC_CODPLANO) FROM TB_PLANOCONTAS'
      '  Where PLC_CODPLANO >= '#39'001'#39'  and '
      '              PLC_CODPLANO<= '#39'999'#39)
    ForcedRefresh = True
    Database = DM.IBD_Gestao
    BufferChunks = 1000
    ParamCheck = True
