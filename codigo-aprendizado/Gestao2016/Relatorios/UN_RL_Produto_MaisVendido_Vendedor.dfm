  object Qr_Produtos: TSTQuery
    Database = DM.IBD_Gestao
    Transaction = DM.IB_Transacao
    ForcedRefresh = True
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      
        'SELECT DISTINCT CLB_CODIGO, CLB_NOME, PRO_CODIGOFAB , PRO_DESCRI' +
        'CAO  , sum(itf_qtde * itf_vl_unit) VDA,sum(ITF_QTDE) QTD'
      
        ' fROM TB_NOTA_FISCAL tb_nota_fiscal                             ' +
        '                '
      
        '    INNER JOIN TB_PEDIDO tb_pedido                              ' +
        '                '
      
        '    ON (tb_pedido.PED_CODIGO = tb_nota_fiscal.NFL_CODPED)       ' +
        '                '
      
        '    INNER JOIN TB_ITENS_NFL tb_itens_nfl                        ' +
        '                '
      
        '    ON (tb_itens_nfl.ITF_CODNFL = tb_nota_fiscal.NFL_CODIGO)    ' +
        '                '
      
        '    INNER JOIN TB_PRODUTO tb_produto                            ' +
        '                '
      
        '    ON (tb_produto.PRO_CODIGO = tb_itens_nfl.ITF_CODPRO)        ' +
        '                '
      
        '    INNER JOIN TB_EMPRESA tb_cliente                            ' +
        '                '
      
        '    ON (tb_cliente.EMP_CODIGO = tb_nota_fiscal.NFL_CODEMP)      ' +
        '                '
      
        '    INNER JOIN TB_ESTOQUE tb_estoque                            ' +
        '                '
      '    ON (tb_estoque.EST_CODPRO = tb_itens_nfl.ITF_CODPRO)'
      '   INNER JOIN TB_COLABORADOR tb_colaborador'
      '   ON (tb_colaborador.CLB_CODIGO = tb_pedido.PED_CODVDO)'
      'where PED_TIPO = 1'
      'group by 1,2,3,4'
      'order by 3 desc'
      ''
      ''
      '')
    Left = 272
    Top = 8
  end
end
