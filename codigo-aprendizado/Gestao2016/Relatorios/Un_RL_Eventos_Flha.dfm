    SQL.Strings = (
      'SELECT'
      ' FPT_CODIGO,'
      ' FPT_CODCLB,'
      ' CLB_NOME,'
      ' FPT_DATA,'
      ' FPT_MES,'
      ' FPT_ANO,'
      ' FPT_HISTORICO,'
      ' FPT_VL_CREDITO,'
      ' FPT_VL_DEBITO'
      'FROM TB_FOLHAPAGTO tb_folhapagto'
