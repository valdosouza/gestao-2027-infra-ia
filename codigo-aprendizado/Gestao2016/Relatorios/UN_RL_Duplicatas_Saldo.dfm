  object Qr_Duplicatas: TSTQuery
    Database = DM.IBD_Gestao
    Transaction = DM.IB_Transacao
    ForcedRefresh = True
    BufferChunks = 1000
    CachedUpdates = False
    ParamCheck = True
    SQL.Strings = (
      'SELECT'
      '   EMP_FANTASIA,'
      '   CAST(SUM(FIN_VL_PARCELA) AS NUMERIC(18, 2)) DIVIDA,'
      '   CAST(SUM(FIN_VL_PAGO) AS NUMERIC(18, 2)) PAGO,'
      '   CAST(SUM(FIN_VL_PARCELA - FIN_VL_PAGO) AS NUMERIC(18, 2)) SALDO'
      'FROM TB_FINANCEIRO tb_financeiro'
      '    INNER JOIN TB_EMPRESA tb_empresa'
      '   ON (tb_empresa.EMP_CODIGO = tb_financeiro.FIN_CODEMP)'
      '   group BY EMP_FANTASIA')
    Left = 476
    Top = 26
    object Qr_DuplicatasEMP_FANTASIA: TStringField
      FieldName = 'EMP_FANTASIA'
      Origin = 'TB_EMPRESA.EMP_FANTASIA'
      Size = 100
    end
    object Qr_DuplicatasDIVIDA: TBCDField
      FieldName = 'DIVIDA'
      Precision = 18
      Size = 2
    end
    object Qr_DuplicatasPAGO: TBCDField
      FieldName = 'PAGO'
      Precision = 18
      Size = 2
    end
    object Qr_DuplicatasSALDO: TBCDField
      FieldName = 'SALDO'
      Precision = 18
      Size = 2
    end
  end
end
