  inherited Qr_Pedido: TSTQuery
    Active = False
    SQL.Strings = (
      'SELECT '
      'EMP_NOME,'
      ' EMP_FANTASIA,'
      'EMP_CODIGO,'
      'END_ENDER,'
      'END_NUMERO,'
      'END_COMPLEM,'
      'END_CONTATO,'
      'END_CEP,'
      'END_FONE,'
      'END_BAIRRO,'
      'CDD_DESCRICAO,'
      'END_FAX,'
      'EMP_CNPJ,'
      'EMP_INSC_EST,'
      'END_CELULAR,'
      'FPT_DESCRICAO,'
      'PED_PRAZO PRAZO,'
      'PED_OBS OBS,'
      'CLB_NOME,'
      'ped_NUMERO,'
      'PED_DATA'
      'UFE_SIGLA ,'
      'PED.ped_vl_desconto'
      ''
      'FROM TB_PEDIDO ped'
      '   INNER JOIN TB_EMPRESA emp'
      '  ON (emp.EMP_CODIGO = ped.PED_CODEMP)'
      ''
      '  INNER JOIN TB_ENDERECO tb_endereco'
      '  ON (tb_endereco.END_CODEMP = emp.EMP_CODIGO)'
      ''
      '  INNER JOIN tb_cidade tb_cidade'
      '  ON (tb_cidade.cdd_codigo = tb_endereco.end_codcdd)'
      ''
      '  INNER JOIN tb_uf tb_uf'
      '  ON (tb_uf.ufe_codigo = tb_endereco.end_codufe)'
      ''
      '  INNER JOIN TB_FORMAPAGTO tb_formapagto'
      '  ON (tb_formapagto.FPT_CODIGO = PED.PED_CODFPG)'
      ''
      '  INNER JOIN TB_COLABORADOR tb_colaborador'
      '  ON (tb_colaborador.CLB_CODIGO = ped.ped_codvdo)'
      ''
      'WHERE(PED_CODIGO =:PED_CODIGO)')
  end
  inherited Qr_ItensPro: TSTQuery
    SQL.Strings = (
      'SELECT'
      '  ITF_CODIGO DETALHE,'
      '  ITF_CODPED CODIGO,'
      '  ITF_CODNFL CODIGONOTA,'
      '  ITF_CODPRO CODIGOPRODUTO,'
      '  PRO_CODIGOFAB,'
      '  PRO_DESCRICAO DESC_PRODUTO,'
      '  PRO_TIPO TIPO,'
      '  ITF_QTDE QTDE,'
      '  ITF_VL_CUSTO CUSTO,'
      '  ITF_VL_UNIT VL_UNIT,'
      '  ITF_AQ_COM AQ_COM,'
      '  ITF_VL_DESC VL_DESC,'
      '  MED_ABREVIATURA MEDIDA,'
      '  PRO_CODIGOFOR,'
      '  ITF_ALTURA,'
      ' ITF_LARGURA,'
      ' ITF_NR_PECAS,'
      '  (ITF_QTDE * ITF_VL_UNIT) SUBTOTAL'
      'FROM TB_ITENS_NFL Tb_itens_nfl'
      '   INNER JOIN TB_PEDIDO Tb_pedido'
      '   ON  (Tb_itens_nfl.ITF_CODPED = Tb_pedido.PED_CODIGO)'
      '   INNER JOIN TB_PRODUTO Tb_produto'
      '   ON  (Tb_produto.PRO_CODIGO = Tb_itens_nfl.ITF_CODPRO)'
      '   INNER JOIN TB_MEDIDA tb_medida'
      '   ON  (tb_medida.MED_CODIGO = tb_produto.PRO_CODMED)'
      'WHERE (ITF_CODPED =:PED_CODIGO) AND (PRO_TIPO = '#39'P'#39')'
      'ORDER BY PRO_DESCRICAO')
    Top = 424
  end
end
