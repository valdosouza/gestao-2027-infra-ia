<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Condition="Exists('$(BDS)\bin\CodeGear.Deployment.targets')" Project="$(BDS)\bin\CodeGear.Deployment.targets"/>
    <ProjectExtensions>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <ItemGroup Condition="'$(Platform)'=='iOSDevice64'"/>
    <ItemGroup Condition="'$(Platform)'=='Win64'"/>
    <ItemGroup Condition="'$(Platform)'=='iOSDevice32'"/>
    <ItemGroup Condition="'$(Platform)'=='Win32'">
        <DeployFile Include="Funcao\UN_NF.PAS" Condition="'$(Config)'=='Debug'">
            <RemoteDir>Gestao\</RemoteDir>
            <RemoteName>UN_NF.PAS</RemoteName>
            <DeployClass>ProjectFile</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="D:\Modelos\Gestao2016\Bin\Gestao.exe" Condition="'$(Config)'=='Debug'">
            <RemoteDir>Gestao\</RemoteDir>
            <RemoteName>Gestao.exe</RemoteName>
            <DeployClass>ProjectOutput</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
            <Required>True</Required>
        </DeployFile>
        <DeployFile Include="D:\Modelos\Gestao2016\Bin\Gestao.exe" Condition="'$(Config)'=='Release'">
            <RemoteDir>Gestao\</RemoteDir>
            <RemoteName>Gestao.exe</RemoteName>
            <DeployClass>ProjectOutput</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
            <Required>True</Required>
        </DeployFile>
        <DeployFile Include="Tarefas\Un_Caixa.PAS" Condition="'$(Config)'=='Release'">
            <RemoteDir>Gestao\</RemoteDir>
            <RemoteName>Un_Caixa.PAS</RemoteName>
            <DeployClass>ProjectFile</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="Tarefas\Un_Caixa.PAS" Condition="'$(Config)'=='Debug'">
            <RemoteDir>Gestao\</RemoteDir>
            <RemoteName>Un_Caixa.PAS</RemoteName>
            <DeployClass>ProjectFile</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
        <DeployFile Include="Funcao\UN_NF.PAS" Condition="'$(Config)'=='Release'">
            <RemoteDir>Gestao\</RemoteDir>
            <RemoteName>UN_NF.PAS</RemoteName>
            <DeployClass>ProjectFile</DeployClass>
            <Operation>0</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
        </DeployFile>
    </ItemGroup>
    <ItemGroup Condition="'$(Platform)'=='OSX32'"/>
    <ItemGroup Condition="'$(Platform)'=='Android'"/>
    <ItemGroup Condition="'$(Platform)'=='iOSSimulator'"/>
</Project>
